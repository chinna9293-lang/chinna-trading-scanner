//@version=5
// ═════════════════════════════════════════════════════════════════════════
// SMA STACK + VWAP + DTR/ATR + VOLUME — "Pro" Textbook Strategy (v3)
// Pine Script v5. Standalone from the "Luxy UT GOD" dashboard strategy.
//
// v3 = a pro-trader pass over v2. What was still wrong with v2, and what
// changed:
//
//  1. STRICT SMA ORDERING WAS TOO FRAGILE
//     v2 required a perfect price>SMA5>SMA10>SMA50>SMA100>SMA200 chain on
//     every bar -> flips true/false constantly near the SMA50/100 lines
//     even in a genuine trend. v3 adds a `slopeConfirm` requirement (each
//     key SMA must also be rising/falling vs N bars ago) instead of relying
//     on rank order alone, and treats the stack as the *primary* filter,
//     not the only one.
//
//  2. NO TREND-STRENGTH FILTER -> traded slow chop that technically had a
//     "stacked" MA order but no real trend behind it. v3 adds a daily
//     ADX(14) >= adxMinTh gate (ta.dmi) — no ADX, no trade.
//
//  3. NO CONFIRMATION CANDLE -> entries fired on VWAP cross alone, often
//     into a doji/reversal bar. v3 requires the trigger bar to actually
//     close in the trade's direction (close>open for longs, close<open
//     for shorts).
//
//  4. NO VOLATILITY-REGIME FILTER -> traded dead, near-zero-ATR names/days
//     where any signal is noise. v3 adds a minimum ATR-as-%-of-price floor.
//
//  5. NO SESSION FILTER -> traded the first few minutes (opening-range
//     whipsaw) and last few minutes (closing auction noise) of the day.
//     v3 adds a configurable trading session window and force-flattens all
//     positions at session end (no overnight gap risk on an intraday
//     system).
//
//  6. SIZE WAS "10% OF EQUITY" REGARDLESS OF STOP DISTANCE -> a wide-stop
//     trade and a tight-stop trade risked wildly different dollar amounts.
//     v3 sizes every trade off a fixed % account risk / stop distance, so
//     every trade risks the same amount.
//
//  7. TARGET WAS "2x ATR" UNRELATED TO THE ACTUAL STOP -> could be <1:1
//     reward:risk on wide-stop days. v3 makes the target a true R-multiple
//     of the ACTUAL stop distance (default 2R).
//
//  8. NO BREAKEVEN / TRAIL -> gave back full winners on reversals. v3 takes
//     partial profit at 1R, moves the remaining stop to breakeven, then
//     trails the runner with an ATR chandelier stop.
//
//  9. NO CIRCUIT BREAKER -> could keep re-entering after a string of
//     losses. v3 adds max trades/day and a max daily-loss %% kill switch.
//
// 10. NO REALISTIC FRICTION IN BACKTEST -> v2 had no slippage/commission,
//     which flatters backtest results. v3 sets both.
//
// 11. NO ON-CHART CONTEXT -> v3 adds a status table (trend, ADX, RVOL,
//     DTR/ATR, session state, today's trade count) so signals are
//     explainable at a glance, plus explicit BUY/SELL labels.
//
// TREND FILTER  : daily SMA 5/10/50/100/200 stack + slope confirmation
// STRENGTH      : daily ADX(14)
// RANGE CONTEXT : today's Daily Trading Range (DTR) vs daily ATR(14)
// TRIGGER       : session VWAP hold/reclaim (long) or reject/loss (short)
//                 + confirmation candle
// CONFIRMATION  : relative volume (RVOL) vs its 20-bar average
// RISK          : fixed %-account risk sizing, R-multiple target,
//                 breakeven + ATR chandelier trail, daily circuit breaker
//
// Intended for intraday charts (5m/15m) with daily-timeframe context via
// request.security(). Educational — not financial advice, not guaranteed.
// ═════════════════════════════════════════════════════════════════════════
strategy("SMA Stack + VWAP + DTR/ATR + Volume — Pro Strategy v3", overlay=true,
     default_qty_type=strategy.fixed, default_qty_value=1,
     pyramiding=0, calc_on_every_tick=false, process_orders_on_close=true,
     commission_type=strategy.commission.percent, commission_value=0.03,
     slippage=2, initial_capital=10000)

// ───────────────────────── INPUTS: TREND ─────────────────────────
smaFastLen   = input.int(5,   "SMA Fast",   minval=1, group="SMA Stack")
sma10Len     = input.int(10,  "SMA 10",     minval=1, group="SMA Stack")
sma50Len     = input.int(50,  "SMA 50",     minval=1, group="SMA Stack")
sma100Len    = input.int(100, "SMA 100",    minval=1, group="SMA Stack")
sma200Len    = input.int(200, "SMA 200",    minval=1, group="SMA Stack")
slopeLookback = input.int(3, "Slope Confirmation Lookback (bars)", minval=1, group="SMA Stack")

// ───────────────────────── INPUTS: TREND STRENGTH ─────────────────────────
adxLen     = input.int(14, "ADX Length (Daily)", minval=1, group="Trend Strength")
adxMinTh   = input.float(20.0, "Minimum ADX (no trade below this)", step=1, group="Trend Strength")

// ───────────────────────── INPUTS: RANGE ─────────────────────────
atrLen       = input.int(14,  "ATR Length (Daily)", minval=1, group="Range (DTR vs ATR)")
exhaustedTh  = input.float(1.5, "Exhausted Threshold (DTR/ATR)",  step=0.05, group="Range (DTR vs ATR)")
minAtrPct    = input.float(0.3, "Min ATR as % of Price (dead-market filter)", step=0.05, group="Range (DTR vs ATR)")

// ───────────────────────── INPUTS: VOLUME ─────────────────────────
rvolLen      = input.int(20,  "RVOL Lookback",             minval=1, group="Volume")
rvolEntryTh  = input.float(1.5, "RVOL Entry Threshold",     step=0.1, group="Volume")
rvolExitTh   = input.float(0.7, "RVOL Exit Threshold (fading)", step=0.1, group="Volume")

// ───────────────────────── INPUTS: RISK / SIZING ─────────────────────────
riskPct       = input.float(1.0, "Risk Per Trade (% of equity)", step=0.1, minval=0.1, group="Risk")
rewardR       = input.float(2.0, "Target = N x Risk (R-multiple)", step=0.5, group="Risk")
minStopATR    = input.float(0.25, "Min Stop Distance (x ATR) — filters instant-SL trades", step=0.05, minval=0.01, group="Risk")
breakevenAtR  = input.float(1.0, "Move Stop to Breakeven After (R)", step=0.25, group="Risk")
chandelierMult = input.float(2.5, "Chandelier Trail (x ATR, after breakeven)", step=0.25, group="Risk")
cooldownBars  = input.int(5, "Cooldown Bars After Exit", minval=0, group="Risk")

// ───────────────────────── INPUTS: CIRCUIT BREAKER ─────────────────────────
maxTradesPerDay = input.int(4, "Max Trades Per Day", minval=1, group="Circuit Breaker")
maxDailyLossPct = input.float(3.0, "Max Daily Loss % (halts new entries)", step=0.5, group="Circuit Breaker")

// ───────────────────────── INPUTS: SESSION ─────────────────────────
sessionInput = input.session("0935-1550", "Trading Session (exchange time, skips open/close noise)", group="Session")
flattenEOD   = input.bool(true, "Flatten All Positions At Session End", group="Session")

// ───────────────────────── DAILY TREND FILTER (SMA STACK + SLOPE) ─────────────────────────
dClose  = request.security(syminfo.tickerid, "D", close, lookahead=barmerge.lookahead_off)
dSma5   = request.security(syminfo.tickerid, "D", ta.sma(close, smaFastLen), lookahead=barmerge.lookahead_off)
dSma10  = request.security(syminfo.tickerid, "D", ta.sma(close, sma10Len),   lookahead=barmerge.lookahead_off)
dSma50  = request.security(syminfo.tickerid, "D", ta.sma(close, sma50Len),   lookahead=barmerge.lookahead_off)
dSma100 = request.security(syminfo.tickerid, "D", ta.sma(close, sma100Len),  lookahead=barmerge.lookahead_off)
dSma200 = request.security(syminfo.tickerid, "D", ta.sma(close, sma200Len),  lookahead=barmerge.lookahead_off)

stackBull = dClose > dSma5 and dSma5 > dSma10 and dSma10 > dSma50 and dSma50 > dSma100 and dSma100 > dSma200
stackBear = dClose < dSma5 and dSma5 < dSma10 and dSma10 < dSma50 and dSma50 < dSma100 and dSma100 < dSma200

slopeUpConfirm   = dSma50 > dSma50[slopeLookback] and dSma10 > dSma10[slopeLookback]
slopeDownConfirm = dSma50 < dSma50[slopeLookback] and dSma10 < dSma10[slopeLookback]

bullishStack = stackBull and slopeUpConfirm
bearishStack = stackBear and slopeDownConfirm

// ───────────────────────── TREND STRENGTH: ADX(14) DAILY ─────────────────────────
[dPlusDI, dMinusDI, dAdx] = request.security(syminfo.tickerid, "D", ta.dmi(adxLen, adxLen), lookahead=barmerge.lookahead_off)
adxOk = not na(dAdx) and dAdx >= adxMinTh

// ───────────────────────── RANGE CONTEXT: DTR vs ATR(14) + DEAD-MARKET FILTER ─────────────────────────
dHigh = request.security(syminfo.tickerid, "D", high, lookahead=barmerge.lookahead_off)
dLow  = request.security(syminfo.tickerid, "D", low,  lookahead=barmerge.lookahead_off)
dtr   = dHigh - dLow

// ATR(14) from days BEFORE today, so today's still-forming range isn't
// baked into its own baseline.
dAtrPrev = request.security(syminfo.tickerid, "D", ta.atr(atrLen)[1], lookahead=barmerge.lookahead_off)

dtrToAtr   = dAtrPrev > 0 ? dtr / dAtrPrev : na
exhausted  = not na(dtrToAtr) and dtrToAtr >= exhaustedTh
atrPctOfPrice = not na(dAtrPrev) and dClose > 0 ? (dAtrPrev / dClose) * 100 : na
deadMarket = na(atrPctOfPrice) or atrPctOfPrice < minAtrPct

// ───────────────────────── INTRADAY TRIGGER: VWAP ─────────────────────────
sessionVwap        = ta.vwap(hlc3)
priceAboveVwap      = close > sessionVwap
justReclaimedVwap   = close[1] <= sessionVwap[1] and close > sessionVwap
priceBelowVwap      = close < sessionVwap
justLostVwap        = close[1] >= sessionVwap[1] and close < sessionVwap

// ───────────────────────── CONFIRMATION CANDLE ─────────────────────────
bullCandle = close > open
bearCandle = close < open

// ───────────────────────── CONFIRMATION: RELATIVE VOLUME ─────────────────────────
avgVol = ta.sma(volume, rvolLen)
rvol   = avgVol > 0 ? volume / avgVol : na

// ───────────────────────── SESSION / TIME FILTER ─────────────────────────
inSession   = not na(time(timeframe.period, sessionInput))
isNewSessionEnd = inSession[1] and not inSession   // bar right after session window closes

// ───────────────────────── DAILY CIRCUIT BREAKER STATE ─────────────────────────
var float dayStartEquity = strategy.equity
var int   tradesToday    = 0
newDay = ta.change(time("D")) != 0
if newDay
    dayStartEquity := strategy.equity
    tradesToday    := 0

dailyPnLPct = dayStartEquity > 0 ? (strategy.equity - dayStartEquity) / dayStartEquity * 100 : 0
circuitTripped = tradesToday >= maxTradesPerDay or dailyPnLPct <= -math.abs(maxDailyLossPct)

// ───────────────────────── COOLDOWN AFTER EXIT ─────────────────────────
var int barsSinceExit = 999999
inCooldown = barsSinceExit < cooldownBars

// ───────────────────────── STOP DISTANCE (raw, pre-sizing) ─────────────────────────
longStopRaw  = math.min(dSma10, sessionVwap)
shortStopRaw = math.max(dSma10, sessionVwap)

minStopDist   = not na(dAtrPrev) ? minStopATR * dAtrPrev : na
longStopDist  = close - longStopRaw
shortStopDist = shortStopRaw - close

longStopValid  = not na(minStopDist) and longStopDist  >= minStopDist
shortStopValid = not na(minStopDist) and shortStopDist >= minStopDist

// ───────────────────────── ENTRY RULES ─────────────────────────
longSetup  = bullishStack and adxOk and (priceAboveVwap or justReclaimedVwap) and bullCandle and
             not na(rvol) and rvol >= rvolEntryTh and not exhausted and not deadMarket and
             longStopValid and not inCooldown and inSession and not circuitTripped

shortSetup = bearishStack and adxOk and (priceBelowVwap or justLostVwap) and bearCandle and
             not na(rvol) and rvol >= rvolEntryTh and not exhausted and not deadMarket and
             shortStopValid and not inCooldown and inSession and not circuitTripped

// ───────────────────────── POSITION SIZE: FIXED % RISK ─────────────────────────
riskAmount   = strategy.equity * (riskPct / 100)
longQty  = longStopDist  > 0 ? riskAmount / longStopDist  : 0
shortQty = shortStopDist > 0 ? riskAmount / shortStopDist : 0

// ───────────────────────── TRADE STATE: ENTRY PRICE / R-TRACKING ─────────────────────────
var float entryPrice     = na
var float initialStop    = na
var float rDistance      = na
var bool  beMoved        = false
var bool  partialDone    = false

// ───────────────────────── EXIT RULES (trend/vwap/range/volume) ─────────────────────────
exitLongTrend  = close < dSma10
exitLongVwap   = close < sessionVwap
exitLongRange  = exhausted
exitLongVol    = not na(rvol) and rvol < rvolExitTh
exitLongSignal = exitLongTrend or exitLongVwap or exitLongRange or exitLongVol

exitShortTrend = close > dSma10
exitShortVwap  = close > sessionVwap
exitShortRange = exhausted
exitShortVol   = not na(rvol) and rvol < rvolExitTh
exitShortSignal = exitShortTrend or exitShortVwap or exitShortRange or exitShortVol

// ───────────────────────── ENTRIES ─────────────────────────
if longSetup and strategy.position_size <= 0 and longQty > 0
    strategy.entry("Long", strategy.long, qty=longQty)
    entryPrice  := close
    initialStop := longStopRaw
    rDistance   := longStopDist
    beMoved     := false
    partialDone := false
    tradesToday := tradesToday + 1

if shortSetup and strategy.position_size >= 0 and shortQty > 0
    strategy.entry("Short", strategy.short, qty=shortQty)
    entryPrice  := close
    initialStop := shortStopRaw
    rDistance   := shortStopDist
    beMoved     := false
    partialDone := false
    tradesToday := tradesToday + 1

// ───────────────────────── MANAGEMENT: PARTIAL AT 1R -> BREAKEVEN -> CHANDELIER TRAIL ─────────────────────────
liveAtr = not na(dAtrPrev) ? dAtrPrev : ta.atr(atrLen)

if strategy.position_size > 0 and not na(entryPrice) and not na(rDistance) and rDistance > 0
    currentR = (close - entryPrice) / rDistance
    // take 50% off at breakevenAtR, move stop to entry
    if currentR >= breakevenAtR and not partialDone
        strategy.close("Long", qty_percent=50, comment="Partial 1R")
        partialDone := true
        beMoved     := true
    trailStop = beMoved ? math.max(entryPrice, ta.highest(high, 20)[1] - chandelierMult * liveAtr) : initialStop
    finalTarget = entryPrice + rewardR * rDistance
    strategy.exit("Long Exit", "Long", stop=trailStop, limit=partialDone ? na : finalTarget)

if strategy.position_size < 0 and not na(entryPrice) and not na(rDistance) and rDistance > 0
    currentR = (entryPrice - close) / rDistance
    if currentR >= breakevenAtR and not partialDone
        strategy.close("Short", qty_percent=50, comment="Partial 1R")
        partialDone := true
        beMoved     := true
    trailStop = beMoved ? math.min(entryPrice, ta.lowest(low, 20)[1] + chandelierMult * liveAtr) : initialStop
    finalTarget = entryPrice - rewardR * rDistance
    strategy.exit("Short Exit", "Short", stop=trailStop, limit=partialDone ? na : finalTarget)

// ───────────────────────── SIGNAL-BASED EXITS (full close) ─────────────────────────
if strategy.position_size > 0 and exitLongSignal
    strategy.close("Long", comment="Trend/VWAP/Range Exit")

if strategy.position_size < 0 and exitShortSignal
    strategy.close("Short", comment="Trend/VWAP/Range Exit")

// ───────────────────────── END-OF-SESSION FLATTEN ─────────────────────────
if flattenEOD and isNewSessionEnd and strategy.position_size != 0
    strategy.close_all(comment="EOD Flatten")

// ───────────────────────── COOLDOWN TRACKING ─────────────────────────
justExited = strategy.position_size == 0 and strategy.position_size[1] != 0
barsSinceExit := justExited ? 0 : barsSinceExit + 1
if justExited
    entryPrice := na
    initialStop := na
    rDistance := na

// ───────────────────────── PLOTS ─────────────────────────
plot(dSma10,  "SMA 10 (D)",  color=color.new(color.blue, 0),   linewidth=1)
plot(dSma50,  "SMA 50 (D)",  color=color.new(color.orange, 0), linewidth=1)
plot(dSma200, "SMA 200 (D)", color=color.new(color.red, 0),    linewidth=2)
plot(sessionVwap, "VWAP", color=color.new(color.yellow, 0), linewidth=2)

bgcolor(bullishStack and adxOk ? color.new(color.green, 92) : bearishStack and adxOk ? color.new(color.red, 92) : na, title="Trend Stack BG")
bgcolor(not inSession ? color.new(color.gray, 88) : na, title="Outside Session")

plotshape(longSetup,  title="Long Entry",  style=shape.triangleup,   location=location.belowbar, color=color.green,  size=size.small)
plotshape(shortSetup, title="Short Entry", style=shape.triangledown, location=location.abovebar, color=color.red,    size=size.small)
plotshape(strategy.position_size > 0 and exitLongSignal,  title="Long Exit Signal",  style=shape.xcross, location=location.abovebar, color=color.orange, size=size.tiny)
plotshape(strategy.position_size < 0 and exitShortSignal, title="Short Exit Signal", style=shape.xcross, location=location.belowbar, color=color.orange, size=size.tiny)

if longSetup
    label.new(bar_index, low, "BUY", style=label.style_label_up, color=color.new(color.green, 0), textcolor=color.white, size=size.small, yloc=yloc.belowbar)
if shortSetup
    label.new(bar_index, high, "SELL", style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white, size=size.small, yloc=yloc.abovebar)

// ───────────────────────── STATUS TABLE ─────────────────────────
var table infoTable = table.new(position.top_right, 2, 8, border_width=1)
if barstate.islast
    table.cell(infoTable, 0, 0, "Trend", bgcolor=color.gray, text_color=color.white)
    table.cell(infoTable, 1, 0, bullishStack ? "BULL" : bearishStack ? "BEAR" : "NONE", bgcolor=bullishStack ? color.green : bearishStack ? color.red : color.gray, text_color=color.white)
    table.cell(infoTable, 0, 1, "ADX(D)", bgcolor=color.gray, text_color=color.white)
    table.cell(infoTable, 1, 1, str.tostring(dAdx, "#.#") + (adxOk ? " OK" : " weak"), bgcolor=adxOk ? color.green : color.red, text_color=color.white)
    table.cell(infoTable, 0, 2, "RVOL", bgcolor=color.gray, text_color=color.white)
    table.cell(infoTable, 1, 2, str.tostring(rvol, "#.##"), bgcolor=not na(rvol) and rvol >= rvolEntryTh ? color.green : color.red, text_color=color.white)
    table.cell(infoTable, 0, 3, "DTR/ATR", bgcolor=color.gray, text_color=color.white)
    table.cell(infoTable, 1, 3, str.tostring(dtrToAtr, "#.##") + (exhausted ? " exhausted" : ""), bgcolor=exhausted ? color.red : color.green, text_color=color.white)
    table.cell(infoTable, 0, 4, "Session", bgcolor=color.gray, text_color=color.white)
    table.cell(infoTable, 1, 4, inSession ? "OPEN" : "CLOSED", bgcolor=inSession ? color.green : color.gray, text_color=color.white)
    table.cell(infoTable, 0, 5, "Trades Today", bgcolor=color.gray, text_color=color.white)
    table.cell(infoTable, 1, 5, str.tostring(tradesToday) + "/" + str.tostring(maxTradesPerDay), bgcolor=tradesToday >= maxTradesPerDay ? color.red : color.gray, text_color=color.white)
    table.cell(infoTable, 0, 6, "Daily PnL", bgcolor=color.gray, text_color=color.white)
    table.cell(infoTable, 1, 6, str.tostring(dailyPnLPct, "#.##") + "%", bgcolor=dailyPnLPct < 0 ? color.red : color.green, text_color=color.white)
    table.cell(infoTable, 0, 7, "Circuit Breaker", bgcolor=color.gray, text_color=color.white)
    table.cell(infoTable, 1, 7, circuitTripped ? "TRIPPED" : "OK", bgcolor=circuitTripped ? color.red : color.green, text_color=color.white)

// ───────────────────────── ALERTS ─────────────────────────
alertcondition(longSetup,  title="BUY Signal",  message="BUY: bullish stack + ADX trend + VWAP hold/reclaim + confirmation candle + RVOL, risk-sized")
alertcondition(shortSetup, title="SELL Signal", message="SELL: bearish stack + ADX trend + VWAP reject/loss + confirmation candle + RVOL, risk-sized")
alertcondition(exitLongSignal,  title="Exit Long Signal",  message="Exit LONG: trend/VWAP broken, range exhausted, or volume fading")
alertcondition(exitShortSignal, title="Exit Short Signal", message="Exit SHORT: trend/VWAP broken, range exhausted, or volume fading")
